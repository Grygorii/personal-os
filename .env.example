# --- MongoDB Atlas (your existing free cluster; use a SEPARATE database) ---
MONGO_URI=mongodb+srv://USER:PASS@silkilinen.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=personal_os

# --- AI provider ---
# Who handles everyday coaching: 'anthropic' or 'gemini'. Deep work (portraits, book
# exams) always prefers Claude when ANTHROPIC_API_KEY is set. If one provider fails
# (e.g. a free-tier 429), the other is used automatically when configured.
LLM_PROVIDER=anthropic

# Anthropic — needs prepaid billing at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
# Model for deep work only (portraits, exams). Defaults to CLAUDE_MODEL.
DEEP_MODEL=

# Gemini — free tier, no card: aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# Leave blank at first. Message your bot, send /start, and it replies with your chat id.
TELEGRAM_CHAT_ID=

# --- Misc ---
TZ=Europe/Dublin
